{
  "name": "better-org-browser",
  "displayName": "Better Org Browser",
  "description": "Granular Salesforce metadata explorer for VS Code.",
  "version": "0.0.1",
  "publisher": "djlasher",
  "repository": {
    "type": "git",
    "url": "https://github.com/djlasher/BetterOrgBrowser.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:betterOrgBrowserView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "betterOrgBrowser",
          "title": "Better Org Browser",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "betterOrgBrowser": [
        {
          "id": "betterOrgBrowserView",
          "name": "Metadata Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "betterOrgBrowser.refresh",
        "title": "Better Org Browser: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "betterOrgBrowser.selectOrg",
        "title": "Better Org Browser: Select Salesforce Org"
      },
      {
        "command": "betterOrgBrowser.showFieldDetails",
        "title": "Better Org Browser: Show Field Details"
      },
      {
        "command": "betterOrgBrowser.copyApiName",
        "title": "Better Org Browser: Copy API Name"
      },
      {
        "command": "betterOrgBrowser.addToManifest",
        "title": "Better Org Browser: Add to Manifest"
      },
      {
        "command": "betterOrgBrowser.removeFromManifest",
        "title": "Better Org Browser: Remove from Manifest"
      },
      {
        "command": "betterOrgBrowser.clearManifestSelections",
        "title": "Better Org Browser: Clear Manifest Selections",
        "icon": "$(clear-all)"
      },
      {
        "command": "betterOrgBrowser.showManifestSelections",
        "title": "Better Org Browser: Show Manifest Selections",
        "icon": "$(list-tree)"
      },
      {
        "command": "betterOrgBrowser.previewManifest",
        "title": "Better Org Browser: Preview Manifest"
      },
      {
        "command": "betterOrgBrowser.writeManifest",
        "title": "Better Org Browser: Write Manifest to File"
      },
      {
        "command": "betterOrgBrowser.retrieveManifest",
        "title": "Better Org Browser: Retrieve Manifest"
      },
      {
        "command": "betterOrgBrowser.syncFieldPermissionEntry",
        "title": "Better Org Browser: Sync Field Permission Entry",
        "icon": "$(cloud-download)"
      },
      {
        "command": "betterOrgBrowser.syncObjectPermissionEntry",
        "title": "Better Org Browser: Sync Object Permission Entry",
        "icon": "$(cloud-download)"
      },
      {
        "command": "betterOrgBrowser.copyFullMetadataPath",
        "title": "Better Org Browser: Copy Full Metadata Path"
      },
      {
        "command": "betterOrgBrowser.showMetadataDetails",
        "title": "Better Org Browser: Inspect Metadata"
      },
      {
        "command": "betterOrgBrowser.searchMetadata",
        "title": "Better Org Browser: Search Metadata",
        "icon": "$(search)"
      },
      {
        "command": "betterOrgBrowser.retrieveSelectedMetadata",
        "title": "Better Org Browser: Retrieve Selected Metadata",
        "icon": "$(cloud-download)"
      },
      {
        "command": "betterOrgBrowser.syncPermissionSetEntry",
        "title": "Better Org Browser: Sync Permission Set Entry",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "betterOrgBrowser.syncPermissionSetEntry",
          "when": "view == betterOrgBrowserView && viewItem =~ /:sync/",
          "group": "inline@1"
        },
        {
          "command": "betterOrgBrowser.addToManifest",
          "when": "view == betterOrgBrowserView && viewItem =~ /:manifest/",
          "group": "navigation@1"
        },
        {
          "command": "betterOrgBrowser.removeFromManifest",
          "when": "view == betterOrgBrowserView && viewItem =~ /:manifest/",
          "group": "navigation@2"
        },
        {
          "command": "betterOrgBrowser.showFieldDetails",
          "when": "view == betterOrgBrowserView && viewItem =~ /:field/",
          "group": "navigation@3"
        },
        {
          "command": "betterOrgBrowser.showMetadataDetails",
          "when": "view == betterOrgBrowserView && viewItem =~ /^node/",
          "group": "navigation@4"
        },
        {
          "command": "betterOrgBrowser.copyApiName",
          "when": "view == betterOrgBrowserView && viewItem =~ /^node/",
          "group": "navigation@5"
        },
        {
          "command": "betterOrgBrowser.copyFullMetadataPath",
          "when": "view == betterOrgBrowserView && viewItem =~ /^node/",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "betterOrgBrowser.showManifestSelections",
          "when": "view == betterOrgBrowserView",
          "group": "navigation@1"
        },
        {
          "command": "betterOrgBrowser.clearManifestSelections",
          "when": "view == betterOrgBrowserView",
          "group": "navigation@2"
        },
        {
          "command": "betterOrgBrowser.refresh",
          "when": "view == betterOrgBrowserView",
          "group": "navigation@3"
        },
        {
          "command": "betterOrgBrowser.selectOrg",
          "when": "view == betterOrgBrowserView",
          "group": "navigation@4"
        },
        {
          "command": "betterOrgBrowser.searchMetadata",
          "when": "view == betterOrgBrowserView",
          "group": "navigation@5"
        },
        {
          "command": "betterOrgBrowser.retrieveSelectedMetadata",
          "when": "view == betterOrgBrowserView",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "betterOrgBrowser.syncFieldPermissionEntry",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.syncObjectPermissionEntry",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.syncPermissionSetEntry",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.showFieldDetails",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.showMetadataDetails",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.copyApiName",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.copyFullMetadataPath",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.addToManifest",
          "when": "false"
        },
        {
          "command": "betterOrgBrowser.removeFromManifest",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:host": "npm run compile && node tests/run-host.cjs"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "fast-xml-parser": "^5.11.2"
  }
}
